@model IEnumerable<ABCBabyShop_2.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<h2>Products</h2>
<a class="btn btn-pink mb-3" href="/Product/Create">Add Product</a>

<div class="row">
    @foreach (var product in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card p-3">
                <img src="@product.ImageUrl" class="img-fluid rounded mb-2" />
                <h5>@product.ProductName</h5>
                <p>Price: @product.Price.ToString("C")</p>
                <a class="btn btn-danger" href="/Product/Delete?rowKey=@product.RowKey">Delete</a>
            </div>
        </div>
    }
</div>
