@model IEnumerable<ABCBabyShop_3.Models.Customer>
@{
    ViewData["Title"] = "Customers";
}
<h1>Customers</h1>
<p><a class="btn btn-success" href="/Customer/Create">Register new</a></p>
<table class="table">
    <thead><tr><th>Name</th><th>Email</th><th></th></tr></thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.CustomerName</td>
                <td>@c.Email</td>
                <td>
                    <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this customer?');">
                        <input type="hidden" name="id" value="@c.Id" />
                        <button class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
