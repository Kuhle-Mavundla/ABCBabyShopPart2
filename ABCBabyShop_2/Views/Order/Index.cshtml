@model IEnumerable<ABCBabyShop_3.Models.Order>
@{
    ViewData["Title"] = "Orders";
}
<h1>Orders</h1>

<table class="table">
    <thead><tr><th>Order ID</th><th>Customer</th><th>Product</th><th>Qty</th><th>Date</th><th></th></tr></thead>
    <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>@o.Id</td>
                <td>@o.CustomerId</td>
                <td>@o.ProductId</td>
                <td>@o.Quantity</td>
                <td>@o.OrderDate.ToLocalTime()</td>
                <td>
                    <form asp-action="Delete" method="post" onsubmit="return confirm('Delete order?');">
                        <input type="hidden" name="id" value="@o.Id" />
                        <button class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
